# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  
  # =============================================================
  # HUB MACHINE (Ubuntu Desktop + Docker Desktop)
  # =============================================================
  config.vm.define "hub" do |hub|
    hub.vm.box = "bento/ubuntu-22.04"
    hub.vm.hostname = "elk-hub"
    hub.vm.network "private_network", ip: "192.168.56.10"

    hub.vm.provider "virtualbox" do |vb|
      vb.gui = false
      vb.memory = "4096" # Reduced to avoid starvation
      vb.cpus = 2
      vb.customize ["modifyvm", :id, "--hwvirtex", "on"] # For Docker Desktop
    end

    hub.vm.provision "shell", path: "hub-vm/provision.sh"
  end

  # =============================================================
  # WINDOWS MACHINE (Windows Server Node B)
  # =============================================================
  config.vm.define "windows" do |windows|
    windows.vm.box = "gusztavvargadr/windows-server-2019-standard"
    windows.vm.hostname = "win-node-b"
    windows.vm.network "private_network", ip: "192.168.56.20"

    windows.vm.provider "virtualbox" do |vb|
      vb.gui = true
      vb.memory = "2048" # Reduced from 4GB
      vb.cpus = 2
    end

    windows.vm.provision "shell", path: "windows-vm/provision.ps1"
  end

  # =============================================================
  # LINUX MACHINE (Linux Edge Node A)
  # =============================================================
  config.vm.define "linux" do |linux|
    linux.vm.box = "bento/ubuntu-22.04"
    linux.vm.hostname = "elk-node-a"
    linux.vm.network "private_network", ip: "192.168.56.30"
    linux.vm.network "forwarded_port", guest: 22, host: 2223, id: "ssh", auto_correct: true

    linux.vm.provider "virtualbox" do |vb|
      vb.gui = true
      vb.memory = "2048" # Reduced from 4GB
      vb.cpus = 2
    end

    linux.vm.provision "shell", path: "linux-vm/provision.sh"
  end

end
